; 대항해 프로토타입 — Godot 4.3
; 에디터에서 이 폴더를 열면 됩니다.

config_version=5

[application]

config/name="대항해 프로토타입"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")

[gui]

; 웹 빌드에는 시스템 폰트가 없다. 넣어두지 않으면 한글이 전부 네모로 나온다.
theme/custom_font="res://fonts/Pretendard-Regular.woff2"

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"

[rendering]

anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.043, 0.086, 0.133, 1)
